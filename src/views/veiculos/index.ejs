<%- include('../partials/header') %>

<h2>Lista de Veículos</h2>

<a href="/veiculos/novo" class="btn btn-success mb-3">
Novo Veículo
</a>

<table class="table table-bordered table-hover">

<thead class="table-dark">

<tr>
<th>ID</th>
<th>Marca</th>
<th>Modelo</th>
<th>Ano</th>
<th>Placa</th>
<th>Ações</th>
</tr>

</thead>

<tbody>

<% veiculos.forEach(veiculo => { %>

<tr>

<td><%= veiculo.id %></td>
<td><%= veiculo.marca %></td>
<td><%= veiculo.modelo %></td>
<td><%= veiculo.ano %></td>
<td><%= veiculo.placa %></td>

<td>

<a href="/veiculos/<%= veiculo.id %>" class="btn btn-info btn-sm">
Detalhes
</a>

<a href="/veiculos/editar/<%= veiculo.id %>" class="btn btn-warning btn-sm">
Editar
</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

<%- include('../partials/footer') %>