<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Clientes | Rodrigo Autoelétrica</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet" href="/css/clientes.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body>

<div class="container">

    <header class="cliente-header">

        <div>

            <h1>

                <i class="fa-solid fa-users"></i>

                Clientes

            </h1>

            <p>

                Gerencie todos os clientes cadastrados na Rodrigo Autoelétrica.

            </p>

        </div>

        <div>

            <a

            href="/clientes/novo"

            class="btn btn-primary">

                <i class="fa-solid fa-user-plus"></i>

                Novo Cliente

            </a>

        </div>

    </header>

    <% if(typeof sucesso !== 'undefined'){ %>

        <div class="alert alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <%= sucesso %>

        </div>

    <% } %>

    <% if(typeof erro !== 'undefined'){ %>

        <div class="alert alert-danger">

            <i class="fa-solid fa-circle-exclamation"></i>

            <%= erro %>

        </div>

    <% } %>

    <section class="cards-veiculos">

        <div class="card-info">

            <h4>

                Total de Clientes

            </h4>

            <h2>

                <%= clientes.length %>

            </h2>

        </div>

        <div class="card-info">

            <h4>

                Clientes Ativos

            </h4>

            <h2>

                <%= clientes.length %>

            </h2>

        </div>

        <div class="card-info">

            <h4>

                Veículos

            </h4>

            <h2>

                <%= totalVeiculos || 0 %>

            </h2>

        </div>

        <div class="card-info">

            <h4>

                Ordens

            </h4>

            <h2>

                <%= totalOrdens || 0 %>

            </h2>

        </div>

    </section>

    <section class="busca-area">

        <form

        action="/clientes"

        method="GET"

        class="w-100 d-flex gap-20">

            <input

            type="text"

            name="busca"

            placeholder="Pesquisar por nome, CPF ou telefone...">

            <button

            class="btn btn-primary"

            type="submit">

                <i class="fa-solid fa-magnifying-glass"></i>

                Buscar

            </button>

        </form>

    </section>

    <section class="table-card">

        <div class="table-responsive">

            <table>

                <thead>

                    <tr>

                        <th>Foto</th>

                        <th>Nome</th>

                        <th>CPF</th>

                        <th>Telefone</th>

                        <th>E-mail</th>

                        <th>Ações</th>

                    </tr>

                </thead>

                <tbody>

                <% if(clientes.length > 0){ %>

                <% clientes.forEach(cliente=>{ %>

                    <tr>

                        <td>

                            <% if(cliente.foto){ %>

                                <img

                                class="veiculo-foto"

                                src="/uploads/<%= cliente.foto %>">

                            <% }else{ %>

                                <img

                                class="veiculo-foto"

                                src="/img/user.png">

                            <% } %>

                        </td>

                        <td>

                            <strong>

                                <%= cliente.nome %>

                            </strong>

                        </td>

                        <td>

                            <%= cliente.cpf %>

                        </td>

                        <td>

                            <%= cliente.telefone %>

                        </td>

                        <td>

                            <%= cliente.email %>

                        </td>

                        <td>

                            <div class="acoes">
                                <a
                                href="/clientes/<%= cliente.id %>"
                                class="btn-detalhes"
                                title="Visualizar"
                            >
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <a
                                href="/clientes/editar/<%= cliente.id %>"
                                class="btn-editar"
                                title="Editar"
                            >
                                <i class="fa-solid fa-pen"></i>
                            </a>

                            <form
                                action="/clientes/excluir/<%= cliente.id %>"
                                method="POST"
                                class="form-excluir"
                                onsubmit="return confirmarExclusao('<%= cliente.nome %>')"
                            >

                                <button
                                    type="submit"
                                    class="btn-excluir"
                                    title="Excluir"
                                >

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </form>

                        </div>

                    </td>

                </tr>

            <% }) %>

            <% }else{ %>

                <tr>

                    <td colspan="6">

                        <div class="empty">

                            <i class="fa-solid fa-users-slash"></i>

                            <h2>

                                Nenhum cliente encontrado

                            </h2>

                            <p>

                                Cadastre o primeiro cliente para começar a utilizar o sistema.

                            </p>

                            <a
                                href="/clientes/novo"
                                class="btn btn-primary mt-20"
                            >

                                <i class="fa-solid fa-user-plus"></i>

                                Cadastrar Cliente

                            </a>

                        </div>

                    </td>

                </tr>

            <% } %>

            </tbody>

        </table>

    </div>

</section>

<section class="pagination mt-30">

    <a href="#">

        <i class="fa-solid fa-chevron-left"></i>

    </a>

    <a href="#" class="active">

        1

    </a>

    <a href="#">

        2

    </a>

    <a href="#">

        3

    </a>

    <a href="#">

        <i class="fa-solid fa-chevron-right"></i>

    </a>

</section>

</div>

<script>

function confirmarExclusao(nome){

return confirm(

    "Tem certeza que deseja excluir o cliente " +

    nome +

    " ?"

);

}

const busca=document.querySelector("input[name='busca']");

if(busca){

busca.addEventListener("focus",()=>{

    busca.style.transition=".3s";

});

}

</script>

</body>

</html>